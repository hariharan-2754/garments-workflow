# ==================================================
# GarmentFlow ERP - Environment Variables
# ==================================================

# MongoDB Connection
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=garmentflow

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=GarmentFlow ERP
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000,http://localhost:8000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
